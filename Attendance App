<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AttendanceDesk</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/sql-wasm.js"></script>
<style>
:root {
  --bg:#0d0d0d; --surface:#161616; --surface2:#1e1e1e;
  --border:#272727; --text:#f0ece3; --muted:#5e5a55;
  --accent:#e8c547; --accent-dim:rgba(232,197,71,0.1);
  --green:#4caf78; --green-dim:rgba(76,175,120,0.1);
  --red:#e05c5c; --red-dim:rgba(224,92,92,0.1);
  --r:10px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;}
.page{display:none;min-height:100vh;flex-direction:column;animation:fi .22s ease;}
.page.active{display:flex;}
@keyframes fi{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}

/* LOADING */
#loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;gap:1rem;}
#loading .spinner{width:40px;height:40px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite;}
#loading p{font-family:'DM Mono',monospace;font-size:.75rem;color:var(--muted);letter-spacing:.1em;}
@keyframes spin{to{transform:rotate(360deg)}}

/* NAV */
nav{display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem;border-bottom:1px solid var(--border);background:rgba(13,13,13,.94);backdrop-filter:blur(14px);position:sticky;top:0;z-index:50;}
.logo{font-weight:800;font-size:1.05rem;letter-spacing:-.02em;color:var(--accent);}
.logo span{color:var(--text);}
.btn-back{background:none;border:1px solid var(--border);color:var(--muted);font-family:'Syne',sans-serif;font-size:.78rem;padding:5px 14px;border-radius:6px;cursor:pointer;transition:all .15s;}
.btn-back:hover{border-color:var(--text);color:var(--text);}

/* HERO */
.hero{padding:3.5rem 2rem 1.5rem;text-align:center;}
.eyebrow{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--accent);margin-bottom:.9rem;}
.hero h1{font-family:'Instrument Serif',serif;font-size:clamp(2.4rem,6vw,4.6rem);line-height:1.05;letter-spacing:-.02em;margin-bottom:.8rem;}
.hero h1 em{font-style:italic;color:var(--accent);}
.hero p{color:var(--muted);font-size:.9rem;max-width:380px;margin:0 auto 2rem;}

/* WRAP */
.wrap{padding:0 2rem 4rem;max-width:960px;margin:0 auto;width:100%;}

/* TOOLBAR */
.toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;}
.toolbar-label{font-family:'DM Mono',monospace;font-size:.65rem;text-transform:uppercase;letter-spacing:.15em;color:var(--muted);}

/* BUTTONS */
.btn{font-family:'Syne',sans-serif;font-size:.82rem;font-weight:600;padding:.5rem 1.1rem;border-radius:7px;cursor:pointer;border:none;transition:all .15s;display:inline-flex;align-items:center;gap:6px;}
.btn-accent{background:var(--accent);color:#0d0d0d;}
.btn-accent:hover{background:#f0d060;transform:translateY(-1px);}
.btn-ghost{background:none;border:1px solid var(--border);color:var(--muted);}
.btn-ghost:hover{border-color:var(--text);color:var(--text);}
.btn-sm{padding:.3rem .8rem;font-size:.75rem;}

/* GRID */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:.9rem;}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1.4rem 1.2rem;cursor:pointer;transition:all .18s;position:relative;overflow:hidden;}
.card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,.55);}
.card-icon{width:40px;height:40px;border-radius:8px;background:var(--accent-dim);border:1px solid rgba(232,197,71,.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:1rem;}
.card-name{font-weight:700;font-size:1rem;margin-bottom:.3rem;}
.card-sub{font-family:'DM Mono',monospace;font-size:.67rem;color:var(--muted);}
.card-actions{position:absolute;top:.65rem;right:.65rem;display:flex;gap:4px;opacity:0;transition:opacity .15s;}
.card:hover .card-actions{opacity:1;}
.icon-btn{background:var(--surface2);border:1px solid var(--border);color:var(--muted);border-radius:5px;width:26px;height:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.72rem;transition:all .12s;}
.icon-btn:hover{border-color:var(--text);color:var(--text);}
.icon-btn.del:hover{border-color:var(--red);color:var(--red);}

/* EMPTY STATE */
.empty-state{text-align:center;padding:3.5rem 2rem;color:var(--muted);}
.empty-state .big{font-size:2.4rem;margin-bottom:.75rem;}
.empty-state p{font-size:.86rem;line-height:1.7;}

/* MODAL */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(7px);display:none;align-items:center;justify-content:center;z-index:200;padding:1rem;}
.overlay.open{display:flex;}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:2rem;width:100%;max-width:420px;box-shadow:0 24px 64px rgba(0,0,0,.7);animation:fi .2s ease;}
.modal h2{font-size:1.2rem;font-weight:700;margin-bottom:.35rem;}
.modal .sub{color:var(--muted);font-size:.82rem;margin-bottom:1.5rem;}
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:.9rem;}
.field label{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);}
.field input{background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:.6rem .85rem;font-family:'Syne',sans-serif;font-size:.9rem;color:var(--text);outline:none;transition:border-color .15s;}
.field input:focus{border-color:var(--accent);}
.field input.err{border-color:var(--red);}
.err-msg{color:var(--red);font-size:.73rem;margin-top:.25rem;display:none;}
.err-msg.show{display:block;}
.modal-footer{display:flex;gap:.6rem;justify-content:flex-end;margin-top:1.4rem;}

/* PW MODAL */
.pw-lock{text-align:center;margin-bottom:1.5rem;}
.pw-lock .icon{font-size:2.4rem;margin-bottom:.5rem;}
.pw-lock h2{font-size:1.25rem;}
.pw-lock p{color:var(--muted);font-size:.82rem;margin-top:.3rem;}

/* PAGE HEADER */
.page-header{padding:1.5rem 2rem .5rem;max-width:960px;margin:0 auto;width:100%;}
.page-header .crumb{font-family:'DM Mono',monospace;font-size:.63rem;text-transform:uppercase;letter-spacing:.15em;color:var(--muted);margin-bottom:.4rem;}
.page-header h2{font-size:1.7rem;font-weight:700;}
.page-header .meta{color:var(--muted);font-size:.82rem;margin-top:.25rem;}

/* TABS */
.tabs{display:flex;gap:.5rem;margin-bottom:1.5rem;}
.tab{font-family:'Syne',sans-serif;font-size:.8rem;font-weight:600;padding:.45rem 1rem;border-radius:7px;cursor:pointer;border:1px solid var(--border);background:none;color:var(--muted);transition:all .15s;}
.tab.active{background:var(--accent-dim);border-color:var(--accent);color:var(--accent);}

/* TABLE */
.table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
table{width:100%;border-collapse:collapse;}
thead{background:var(--surface2);}
thead th{font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);padding:.85rem 1rem;text-align:left;font-weight:500;}
tbody tr{border-top:1px solid var(--border);transition:background .12s;}
tbody tr:hover{background:var(--surface2);}
tbody td{padding:.72rem 1rem;font-size:.87rem;vertical-align:middle;}
.roll-badge{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted);}
.td-actions{display:flex;gap:6px;}

/* ATTENDANCE */
.chk{width:19px;height:19px;accent-color:var(--accent);cursor:pointer;}
.time-cell input[type=time]{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:.3rem .65rem;font-family:'DM Mono',monospace;font-size:.8rem;color:var(--text);outline:none;width:118px;transition:border-color .15s;}
.time-cell input[type=time]:focus{border-color:var(--accent);}
.time-locked{color:var(--muted);font-size:.72rem;font-family:'DM Mono',monospace;}

/* PILLS */
.pills{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.2rem;}
.pill{font-family:'DM Mono',monospace;font-size:.7rem;padding:4px 12px;border-radius:99px;border:1px solid;display:flex;align-items:center;gap:5px;}
.pill-total{background:var(--surface);border-color:var(--border);color:var(--muted);}
.pill-done{background:var(--green-dim);border-color:var(--green);color:var(--green);}
.pill-absent{background:var(--red-dim);border-color:var(--red);color:var(--red);}
.pill-both{background:rgba(130,100,220,.1);border-color:rgba(150,120,240,.5);color:#b89fff;}
.pill-pending{background:rgba(232,197,71,.07);border-color:rgba(232,197,71,.35);color:var(--accent);}

/* DATE ROW */
.date-row{display:flex;align-items:center;gap:1rem;margin-bottom:1.2rem;flex-wrap:wrap;}
.date-row label{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);}
.date-row input[type=date]{background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:.42rem .8rem;font-family:'DM Mono',monospace;font-size:.82rem;color:var(--text);outline:none;transition:border-color .15s;}
.date-row input[type=date]:focus{border-color:var(--accent);}

/* PERCENTAGE BAR */
.pct-bar-wrap{width:100px;height:8px;background:var(--surface2);border-radius:99px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px;}
.pct-bar{height:100%;border-radius:99px;transition:width .3s;}
.pct-high{background:var(--green);}
.pct-mid{background:var(--accent);}
.pct-low{background:var(--red);}
.pct-label{font-family:'DM Mono',monospace;font-size:.75rem;vertical-align:middle;}

/* TOAST */
.toast{position:fixed;bottom:1.8rem;right:1.8rem;background:var(--surface2);border:1px solid var(--border);border-radius:9px;padding:.72rem 1.2rem;font-size:.82rem;color:var(--text);box-shadow:0 8px 32px rgba(0,0,0,.5);z-index:400;transform:translateY(10px);opacity:0;transition:all .2s;pointer-events:none;}
.toast.show{transform:translateY(0);opacity:1;}
.toast.success{border-color:var(--green);color:var(--green);}
.toast.error{border-color:var(--red);color:var(--red);}

@media(max-width:580px){
  nav, .wrap, .page-header{padding-left:1rem;padding-right:1rem;}
  .hero{padding:2rem 1rem 1rem;}
  .grid{grid-template-columns:1fr 1fr;}
  .modal{padding:1.5rem;}
}
</style>
</head>
<body>

<!-- LOADING SCREEN -->
<div id="loading">
  <div class="spinner"></div>
  <p>Loading SQLite database…</p>
</div>

<!-- ═══ PAGE: HOME ═══ -->
<div class="page" id="page-home">
  <nav>
    <div class="logo">Attendance<span>Desk</span></div>
    <button class="btn btn-accent btn-sm" onclick="openAddSection()">+ New Section</button>
  </nav>
  <div class="hero">
    <div class="eyebrow">Classroom Manager</div>
    <h1>Your <em>Sections</em><br>at a Glance</h1>
    <p>Each section is password-protected. Click to unlock and take attendance.</p>
  </div>
  <div class="wrap">
    <div class="toolbar">
      <span class="toolbar-label" id="section-count">—</span>
    </div>
    <div class="grid" id="sections-grid"></div>
    <div class="empty-state" id="sections-empty" style="display:none">
      <div class="big">📋</div>
      <p>No sections yet.<br>Click <strong>+ New Section</strong> to create one.</p>
    </div>
  </div>
</div>

<!-- ═══ PAGE: STUDENTS ═══ -->
<div class="page" id="page-students">
  <nav>
    <div class="logo" onclick="goHome()" style="cursor:pointer" title="Go to Home">Attendance<span>Desk</span></div>
    <button class="btn-back" onclick="goHome()">← Home</button>
  </nav>
  <div class="page-header">
    <div class="crumb">Section</div>
    <h2 id="sp-name">—</h2>
    <div class="meta" id="sp-desc"></div>
  </div>
  <div class="wrap">
    <div class="tabs">
      <button class="tab active" id="tab-btn-students" onclick="switchTab('students')">👥 Students</button>
      <button class="tab" id="tab-btn-attendance" onclick="switchTab('attendance')">✅ Attendance</button>
      <button class="tab" id="tab-btn-percentage" onclick="switchTab('percentage')">📊 Percentage</button>
    </div>

    <!-- STUDENTS TAB -->
    <div id="tab-students">
      <div class="toolbar">
        <span class="toolbar-label" id="student-count">—</span>
        <button class="btn btn-accent btn-sm" onclick="openAddStudent()">+ Add Student</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Name</th><th>Roll No.</th><th>Actions</th></tr></thead>
          <tbody id="students-tbody"></tbody>
        </table>
        <div class="empty-state" id="students-empty" style="display:none;padding:2.5rem 2rem;">
          <div class="big">🎓</div>
