function deleteStudent(id) {
  if (!confirm('Remove this student and their attendance records?')) return;
  run('DELETE FROM attendance WHERE student_id=?', [id]);
  run('DELETE FROM students WHERE id=?', [id]);
  toast('Student removed', 'error');
  renderStudents();
}

// ══════════════════════════════════════════════
//  ATTENDANCE
// ══════════════════════════════════════════════
function loadAttendance() {
  const date = document.getElementById('att-date').value;
  const students = q('SELECT * FROM students WHERE section_id=? ORDER BY roll_no,name', [currentSectionId]);
  const tbody = document.getElementById('att-tbody');
  const empty = document.getElementById('att-empty');

  if (!students.length) {
    tbody.innerHTML = '';
    empty.style.display = 'block';
    updateAttSummary([]);
    return;
  }
  empty.style.display = 'none';

  tbody.innerHTML = students.map((s, i) => {
    let rec = { present: 0, absent: 0, entry_time: '' };
    if (date) {
      const r = q('SELECT * FROM attendance WHERE student_id=? AND date=?', [s.id, date]);
      if (r.length) rec = r[0];
    }
    const both = rec.present && rec.absent;
    const timeHtml = both
      ? `<input type="time" id="time-${s.id}" value="${rec.entry_time || ''}"/>`
      : `<span class="time-locked">check both →</span>`;

    return `
      <tr>
        <td class="roll-badge">${i + 1}</td>
        <td>${esc(s.name)}<br><span class="roll-badge">${esc(s.roll_no || '')}</span></td>
        <td style="text-align:center">
          <input class="chk" type="checkbox" id="pres-${s.id}" ${rec.present ? 'checked' : ''}
                 onchange="onAttCheck(${s.id})"/>
        </td>
        <td style="text-align:center">
          <input class="chk" type="checkbox" id="abs-${s.id}" ${rec.absent ? 'checked' : ''}
                 onchange="onAttCheck(${s.id})"/>
        </td>
        <td class="time-cell" id="tc-${s.id}">${timeHtml}</td>
      </tr>`;
  }).join('');

  updateAttSummary(students);
}

function onAttCheck(sid) {
  const p = document.getElementById(`pres-${sid}`)?.checked;
  const a = document.getElementById(`abs-${sid}`)?.checked;
  const cell = document.getElementById(`tc-${sid}`);

  if (p && a) {
    const cur = document.getElementById(`time-${sid}`)?.value || '';
    cell.innerHTML = `<input type="time" id="time-${sid}" value="${cur}"/>`;
  } else {
    cell.innerHTML = `<span class="time-locked">check both →</span>`;
  }

  const students = q('SELECT id FROM students WHERE section_id=?', [currentSectionId]);
  updateAttSummary(students);
}

function updateAttSummary(students) {
  let present = 0, absent = 0, both = 0, pending = 0;
  students.forEach(s => {
    const p = document.getElementById(`pres-${s.id}`)?.checked;
    const a = document.getElementById(`abs-${s.id}`)?.checked;
    if (p && a)      { both++; }
    else if (p)      { present++; }
    else if (a)      { absent++; }
    else             { pending++; }
  });
  document.getElementById('att-total').textContent   = students.length;
  document.getElementById('att-done').textContent    = present;
  document.getElementById('att-absent').textContent  = absent;
  document.getElementById('att-both').textContent    = both;
  document.getElementById('att-pending').textContent = pending;
}

function saveAttendance() {
  const date = document.getElementById('att-date').value;
  if (!date) { toast('Select a date first', 'error'); return; }

  const students = q('SELECT id FROM students WHERE section_id=?', [currentSectionId]);
  if (!students.length) { toast('No students to save', 'error'); return; }

  students.forEach(s => {
    const p = document.getElementById(`pres-${s.id}`)?.checked ? 1 : 0;
    const a = document.getElementById(`abs-${s.id}`)?.checked  ? 1 : 0;
    const t = (p && a) ? (document.getElementById(`time-${s.id}`)?.value || '') : '';
    run(`INSERT INTO attendance(student_id,section_id,date,present,absent,entry_time)
         VALUES(?,?,?,?,?,?)
         ON CONFLICT(student_id,date) DO UPDATE SET
           present=excluded.present,
           absent=excluded.absent,
           entry_time=excluded.entry_time`,
      [s.id, currentSectionId, date, p, a, t]);
  });
  toast('Attendance saved ✓', 'success');
}

// ══════════════════════════════════════════════
//  TABS
// ══════════════════════════════════════════════
function switchTab(tab) {
  document.getElementById('tab-btn-students').classList.toggle('active',   tab === 'students');
  document.getElementById('tab-btn-attendance').classList.toggle('active', tab === 'attendance');
  document.getElementById('tab-btn-percentage').classList.toggle('active', tab === 'percentage');
  document.getElementById('tab-students').style.display   = tab === 'students'   ? 'block' : 'none';
  document.getElementById('tab-attendance').style.display = tab === 'attendance' ? 'block' : 'none';
  document.getElementById('tab-percentage').style.display = tab === 'percentage' ? 'block' : 'none';
  if (tab === 'attendance') {
    document.getElementById('att-date').value = new Date().toISOString().split('T')[0];
    loadAttendance();
  }
  if (tab === 'percentage') {
    loadPercentage();
  }
}

// ══════════════════════════════════════════════
//  PERCENTAGE
// ══════════════════════════════════════════════
function loadPercentage() {
  const students = q('SELECT * FROM students WHERE section_id=? ORDER BY roll_no,name', [currentSectionId]);
  const tbody = document.getElementById('pct-tbody');
  const empty = document.getElementById('pct-empty');

  if (!students.length) {
    tbody.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';

  tbody.innerHTML = students.map((s, i) => {
    const records = q(
      'SELECT present, absent FROM attendance WHERE student_id=? AND section_id=? AND (present=1 OR absent=1)',
      [s.id, currentSectionId]
    );

    let effectivePresent = 0, presentDays = 0, absentDays = 0;

    records.forEach(r => {
      const p = r.present, a = r.absent;
      if (p && a)      { effectivePresent += 0.5; }
      else if (p)      { presentDays++; effectivePresent += 1; }
      else if (a)      { absentDays++; }
    });

    const total    = records.filter(r => r.present || r.absent).length;
    const pct      = total > 0 ? Math.round((effectivePresent / total) * 100) : 0;
    const barClass = pct >= 75 ? 'pct-high' : pct >= 50 ? 'pct-mid' : 'pct-low';
    const color    = pct >= 75 ? 'var(--green)' : pct >= 50 ? 'var(--accent)' : 'var(--red)';

    return `
      <tr>
        <td class="roll-badge">${i + 1}</td>
        <td>${esc(s.name)}</td>
        <td class="roll-badge">${esc(s.roll_no || '—')}</td>
        <td style="color:var(--green);font-family:'DM Mono',monospace;font-size:.82rem;">${presentDays}</td>
        <td style="color:var(--red);font-family:'DM Mono',monospace;font-size:.82rem;">${absentDays}</td>
        <td style="font-family:'DM Mono',monospace;font-size:.82rem;">${total}</td>
        <td>
          <div class="pct-bar-wrap"><div class="pct-bar ${barClass}" style="width:${pct}%"></div></div>
          <span class="pct-label" style="color:${color}">${pct}%</span>
        </td>
      </tr>`;
  }).join('');
}

// ══════════════════════════════════════════════
//  MODAL HELPERS
// ══════════════════════════════════════════════
function openModal(id)  { document.getElementById(id).classList.add('open');    document.body.style.overflow = 'hidden'; }
function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }

document.querySelectorAll('.overlay').forEach(o =>
  o.addEventListener('click', e => { if (e.target === o) closeModal(o.id); })
);

function clearErr(modalId) {
  document.querySelectorAll(`#${modalId} .err-msg`).forEach(e => e.classList.remove('show'));
  document.querySelectorAll(`#${modalId} input`).forEach(i => i.classList.remove('err'));
}
function showErrEl(id) { document.getElementById(id).classList.add('show'); }
function hideErrEl(id) { document.getElementById(id).classList.remove('show'); }
function markErr(id)   { document.getElementById(id).classList.add('err'); }

// ══════════════════════════════════════════════
//  TOAST
// ══════════════════════════════════════════════
let toastTimer;
function toast(msg, type = '') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast show ${type}`;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2800);
}

// ══════════════════════════════════════════════
//  UTILS
// ══════════════════════════════════════════════
function esc(s) {
  return String(s ?? '')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

