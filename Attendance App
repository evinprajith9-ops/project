function openAddStudent() {
  editingStudentId = null;
  document.getElementById('mst-title').textContent = 'Add Student';
  document.getElementById('inp-stu-name').value = '';
  document.getElementById('inp-stu-roll').value = '';
  clearErr('modal-student');
