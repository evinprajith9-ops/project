    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-student')">Cancel</button>
      <button class="btn btn-accent" onclick="saveStudent()">Save</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
// ══════════════════════════════════════════════
//  DATABASE — sql.js (SQLite compiled to WASM)
//  Persisted in IndexedDB (primary) + localStorage (backup)
// ══════════════════════════════════════════════
const DB_KEY = 'attendancedesk_v1';
let DB = null;

async function initDB() {
  const SQL = await initSqlJs({
    locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/${f}`
  });

  let loaded = false;
  const idbData = await loadFromIDB();
  if (idbData) {
    try { DB = new SQL.Database(idbData); loaded = true; } catch(e) {}
  }
  if (!loaded) {
    const saved = localStorage.getItem(DB_KEY);
    if (saved) {
      try {
        const bytes = Uint8Array.from(atob(saved), c => c.charCodeAt(0));
        DB = new SQL.Database(bytes); loaded = true;
      } catch(e) {}
    }
  }
  if (!loaded) {
    DB = new SQL.Database();
  }

  DB.run(`
    CREATE TABLE IF NOT EXISTS sections (
      id          INTEGER PRIMARY KEY AUTOINCREMENT,
      name        TEXT NOT NULL,
      description TEXT DEFAULT '',
      password    TEXT NOT NULL,
      created_at  TEXT DEFAULT (datetime('now','localtime'))
    );
    CREATE TABLE IF NOT EXISTS students (
      id         INTEGER PRIMARY KEY AUTOINCREMENT,
      section_id INTEGER NOT NULL,
      name       TEXT NOT NULL,
      roll_no    TEXT DEFAULT '',
      created_at TEXT DEFAULT (datetime('now','localtime')),
      FOREIGN KEY(section_id) REFERENCES sections(id)
    );
    CREATE TABLE IF NOT EXISTS attendance (
      id         INTEGER PRIMARY KEY AUTOINCREMENT,
      student_id INTEGER NOT NULL,
      section_id INTEGER NOT NULL,
      date       TEXT NOT NULL,
      present    INTEGER DEFAULT 0,
      absent     INTEGER DEFAULT 0,
      entry_time TEXT DEFAULT '',
      UNIQUE(student_id, date),
      FOREIGN KEY(student_id) REFERENCES students(id)
    );
  `);

  save();
}

// ── Dual persistence: localStorage + IndexedDB ──
const IDB_NAME = 'attendancedesk';
const IDB_STORE = 'db';
const IDB_KEY_VAL = 'main';

function save() {
  const data = DB.export();
  const b64 = btoa(String.fromCharCode(...data));
  try { localStorage.setItem(DB_KEY, b64); } catch(e) {}
  saveToIDB(data);
}

function saveToIDB(data) {
  const req = indexedDB.open(IDB_NAME, 1);
  req.onupgradeneeded = e => e.target.result.createObjectStore(IDB_STORE);
  req.onsuccess = e => {
    const db = e.target.result;
    const tx = db.transaction(IDB_STORE, 'readwrite');
    tx.objectStore(IDB_STORE).put(data, IDB_KEY_VAL);
  };
}

function loadFromIDB() {
  return new Promise((resolve) => {
    const req = indexedDB.open(IDB_NAME, 1);
    req.onupgradeneeded = e => e.target.result.createObjectStore(IDB_STORE);
    req.onsuccess = e => {
      const db = e.target.result;
      const tx = db.transaction(IDB_STORE, 'readonly');
      const get = tx.objectStore(IDB_STORE).get(IDB_KEY_VAL);
      get.onsuccess = () => resolve(get.result || null);
      get.onerror   = () => resolve(null);
    };
    req.onerror = () => resolve(null);
  });
}

function q(sql, params = []) {
  const res = DB.exec(sql, params);
  if (!res.length) return [];
  const { columns, values } = res[0];
  return values.map(r => Object.fromEntries(columns.map((c, i) => [c, r[i]])));
}

function run(sql, params = []) {
  DB.run(sql, params);
  save();
}

// ══════════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════════
let currentSectionId = null;
let editingSectionId = null;
let editingStudentId = null;
let pendingSectionId = null;
let pendingEditId    = null;
let pendingDeleteId  = null;

// ══════════════════════════════════════════════
//  NAVIGATION
// ══════════════════════════════════════════════
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function goHome() {
  currentSectionId = null;
  showPage('page-home');
  renderHome();
}

// ══════════════════════════════════════════════
//  HOME
// ══════════════════════════════════════════════
const ICONS = ['📚','🔬','🎨','🏛️','🌍','🧮','💻','🎵','🏃','🔭','⚗️','📐'];

function renderHome() {
  const sections = q('SELECT * FROM sections ORDER BY name');
  const grid = document.getElementById('sections-grid');
  const empty = document.getElementById('sections-empty');

  document.getElementById('section-count').textContent =
    `${sections.length} section${sections.length !== 1 ? 's' : ''}`;

  if (!sections.length) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';

  grid.innerHTML = sections.map((s, i) => {
    const cnt = q('SELECT COUNT(*) c FROM students WHERE section_id=?', [s.id])[0]?.c || 0;
    return `
      <div class="card" onclick="askPassword(${s.id})">
        <div class="card-actions" onclick="event.stopPropagation()">
          <div class="icon-btn" title="Edit" onclick="openEditSection(${s.id})">✏️</div>
          <div class="icon-btn del" title="Delete" onclick="deleteSection(${s.id})">🗑</div>
        </div>
        <div class="card-icon">${ICONS[i % ICONS.length]}</div>
        <div class="card-name">${esc(s.name)}</div>
        <div class="card-sub">${esc(s.description || '—')} · ${cnt} student${cnt !== 1 ? 's' : ''}</div>
      </div>`;
  }).join('');
}

// ── Section CRUD ──
function openAddSection() {
  editingSectionId = null;
  document.getElementById('ms-title').textContent = 'New Section';
  document.getElementById('inp-sec-name').value = '';
  document.getElementById('inp-sec-desc').value = '';
  document.getElementById('inp-sec-pw').value = '';
  document.getElementById('pw-field-label').textContent = 'Password';
  clearErr('modal-section');
  openModal('modal-section');
  setTimeout(() => document.getElementById('inp-sec-name').focus(), 150);
}

function openEditSection(id) {
  pendingEditId = id;
  const s = q('SELECT * FROM sections WHERE id=?', [id])[0];
  document.getElementById('pw-title').textContent = s.name;
  document.getElementById('pw-subtitle').textContent = 'Enter the password to edit this section.';
  document.getElementById('inp-pw').value = '';
  hideErrEl('err-pw');
  document.getElementById('inp-pw').classList.remove('err');
  openModal('modal-pw');
  setTimeout(() => document.getElementById('inp-pw').focus(), 200);
}

function doOpenEditSection(id) {
  editingSectionId = id;
  const s = q('SELECT * FROM sections WHERE id=?', [id])[0];
  document.getElementById('ms-title').textContent = 'Edit Section';
  document.getElementById('inp-sec-name').value = s.name;
  document.getElementById('inp-sec-desc').value = s.description || '';
  document.getElementById('inp-sec-pw').value = '';
  document.getElementById('pw-field-label').textContent = 'New Password (leave blank to keep current)';
  clearErr('modal-section');
  openModal('modal-section');
}

function saveSection() {
  const name = document.getElementById('inp-sec-name').value.trim();
  const desc = document.getElementById('inp-sec-desc').value.trim();
  const pw   = document.getElementById('inp-sec-pw').value;
  let ok = true;

  if (!name) { showErrEl('err-sec-name'); markErr('inp-sec-name'); ok = false; }
  else        { hideErrEl('err-sec-name'); }

  if (!editingSectionId && !pw) { showErrEl('err-sec-pw'); markErr('inp-sec-pw'); ok = false; }
  else                          { hideErrEl('err-sec-pw'); }

  if (!ok) return;

  if (editingSectionId) {
    if (pw) run('UPDATE sections SET name=?,description=?,password=? WHERE id=?', [name, desc, pw, editingSectionId]);
    else    run('UPDATE sections SET name=?,description=? WHERE id=?', [name, desc, editingSectionId]);
    toast('Section updated ✓', 'success');
  } else {
    run('INSERT INTO sections(name,description,password) VALUES(?,?,?)', [name, desc, pw]);
    toast('Section created ✓', 'success');
  }
  closeModal('modal-section');
  renderHome();
}

function deleteSection(id) {
  pendingDeleteId = id;
  const s = q('SELECT * FROM sections WHERE id=?', [id])[0];
  document.getElementById('pw-title').textContent = s.name;
  document.getElementById('pw-subtitle').textContent = 'Enter the password to delete this section.';
  document.getElementById('inp-pw').value = '';
  hideErrEl('err-pw');
  document.getElementById('inp-pw').classList.remove('err');
  openModal('modal-pw');
  setTimeout(() => document.getElementById('inp-pw').focus(), 200);
}

function doDeleteSection(id) {
  run('DELETE FROM attendance WHERE section_id=?', [id]);
  run('DELETE FROM students WHERE section_id=?', [id]);
  run('DELETE FROM sections WHERE id=?', [id]);
  toast('Section deleted', 'error');
  renderHome();
}

// ── Password unlock ──
function askPassword(id) {
  pendingSectionId = id;
  const s = q('SELECT * FROM sections WHERE id=?', [id])[0];
  document.getElementById('pw-title').textContent = s.name;
  document.getElementById('pw-subtitle').textContent = 'Enter the password to access this section.';
  document.getElementById('inp-pw').value = '';
  hideErrEl('err-pw');
  document.getElementById('inp-pw').classList.remove('err');
  openModal('modal-pw');
  setTimeout(() => document.getElementById('inp-pw').focus(), 200);
}

function verifyPassword() {
  const entered = document.getElementById('inp-pw').value;
  const targetId = pendingEditId || pendingDeleteId || pendingSectionId;
  const s = q('SELECT * FROM sections WHERE id=?', [targetId])[0];
  if (entered === s.password) {
    closeModal('modal-pw');
    if (pendingEditId) {
      const editId = pendingEditId;
      pendingEditId = null;
      doOpenEditSection(editId);
    } else if (pendingDeleteId) {
      const delId = pendingDeleteId;
      pendingDeleteId = null;
      if (confirm('Delete this section will delete all its students & attendance records? This cannot be undone.')) {
        doDeleteSection(delId);
      }
    } else {
      enterSection(pendingSectionId);
    }
  } else {
    showErrEl('err-pw');
    markErr('inp-pw');
    document.getElementById('inp-pw').value = '';
    document.getElementById('inp-pw').focus();
  }
}

function enterSection(id) {
  currentSectionId = id;
  const s = q('SELECT * FROM sections WHERE id=?', [id])[0];
  document.getElementById('sp-name').textContent = s.name;
  document.getElementById('sp-desc').textContent = s.description || '';
  switchTab('students');
  showPage('page-students');
  renderStudents();
}

